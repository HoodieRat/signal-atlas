<Window x:Class="SignalAtlas.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Signal Atlas" Width="1080" Height="760" MinWidth="850" MinHeight="600" Background="#F5F7F4">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Margin" Value="0,4,10,4"/><Setter Property="Padding" Value="14,8"/><Setter Property="Background" Value="#176B52"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="TextBox"><Setter Property="Margin" Value="0,4,0,12"/><Setter Property="Padding" Value="8"/></Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#173C34" Padding="24,18"><StackPanel><TextBlock Text="SIGNAL ATLAS" FontSize="22" FontWeight="Bold" Foreground="White"/><TextBlock Text="Private local research, scheduled on your computer" Foreground="#D8E9DE"/></StackPanel></Border>
    <Border DockPanel.Dock="Bottom" Background="#E7EEE9" Padding="14"><TextBlock Text="{Binding Status}"/></Border>
    <TabControl Margin="18" FontSize="14" SelectedIndex="{Binding MainTabIndex,Mode=TwoWay}">
      <TabItem Header="Setup"><TabControl Margin="12" SelectedIndex="{Binding SetupStep,Mode=TwoWay}">
        <TabItem Header="Welcome"><ScrollViewer><StackPanel Margin="22" MaxWidth="790" HorizontalAlignment="Left"><TextBlock Text="Signal Atlas" FontSize="26" FontWeight="Bold"/><TextBlock Margin="0,8,0,20" Text="Automatically research the topics you care about and create a private local summary. Setup takes you through the browser, AI provider, topics, and schedule."/><WrapPanel><Button Content="Start setup" Command="{Binding SetupNextCommand}"/><Button Content="Advanced setup" Command="{Binding AdvancedSetupCommand}"/></WrapPanel></StackPanel></ScrollViewer></TabItem>
        <TabItem Header="Browser"><ScrollViewer><StackPanel Margin="22" MaxWidth="790" HorizontalAlignment="Left"><TextBlock Text="Browser connection" FontSize="26" FontWeight="Bold"/><TextBlock Margin="0,8,0,18" Text="DokoBot local mode uses an installed browser extension and native bridge. Approve the extension in Edge or Chrome when your browser asks."/><WrapPanel><Button Content="Install DokoBot CLI" Command="{Binding InstallDokoCommand}"/><Button Content="Install Edge bridge" Command="{Binding InstallBridgeCommand}"/><Button Content="Check connection" Command="{Binding RunDiagnosticsCommand}"/></WrapPanel><DataGrid ItemsSource="{Binding Diagnostics}" AutoGenerateColumns="False" IsReadOnly="True" Height="220" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Component" Binding="{Binding Component}" Width="170"/><DataGridCheckBoxColumn Header="Ready" Binding="{Binding Healthy}" Width="80"/><DataGridTextColumn Header="Result" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid><WrapPanel><Button Content="Back" Command="{Binding SetupBackCommand}"/><Button Content="Next: AI model" Command="{Binding SetupNextCommand}"/></WrapPanel></StackPanel></ScrollViewer></TabItem>
        <TabItem Header="AI model"><ScrollViewer><StackPanel Margin="22" MaxWidth="790" HorizontalAlignment="Left">
          <TextBlock Text="Set up a local AI model" FontSize="26" FontWeight="Bold"/>
          <TextBlock Margin="0,8,0,14" Text="LM Studio runs on your computer. No OpenAI API key is needed. Install a model, choose it in the list, then test it." TextWrapping="Wrap"/>
          <TextBlock Text="1. Install LM Studio and a model" FontWeight="SemiBold"/>
          <WrapPanel><Button Content="Get LM Studio" Command="{Binding OpenLmStudioInstallCommand}"/><Button Content="Install fast model" Command="{Binding InstallFastCommand}"/><Button Content="Install quality model" Command="{Binding InstallQualityCommand}"/><Button Content="Find installed models" Command="{Binding LoadModelsCommand}"/></WrapPanel>
          <TextBlock Text="2. Highlight an installed model and use it" FontWeight="SemiBold" Margin="0,14,0,4"/>
          <DataGrid ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" AutoGenerateColumns="False" IsReadOnly="True" Height="200"><DataGrid.Columns><DataGridTextColumn Header="Model" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Size" Binding="{Binding SizeBytes}" Width="140"/></DataGrid.Columns></DataGrid>
          <Button Content="Use selected model" Command="{Binding SelectModelCommand}" HorizontalAlignment="Left"/>
          <TextBlock Text="Selected model:"/><TextBlock Text="{Binding SelectedModelKey}" FontWeight="SemiBold" FontSize="18"/>
          <TextBlock Text="3. Test the selected model" FontWeight="SemiBold" Margin="0,14,0,4"/>
          <TextBlock Text="The test uses the highlighted model and saves that choice. If resources are low, the message will explain what needs attention." TextWrapping="Wrap"/>
          <Button Content="Test selected model" Command="{Binding TestLocalModelCommand}" HorizontalAlignment="Left"/>
          <Button Content="Choose API or Codex instead" Command="{Binding OpenAiSettingsCommand}" HorizontalAlignment="Left"/>
          <WrapPanel><Button Content="Back" Command="{Binding SetupBackCommand}"/><Button Content="Next: topics" Command="{Binding SetupNextCommand}"/></WrapPanel>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="Topics"><ScrollViewer><StackPanel Margin="22" MaxWidth="790" HorizontalAlignment="Left"><TextBlock Text="Initial topics" FontSize="26" FontWeight="Bold"/><TextBlock Margin="0,8,0,16" Text="Start with suggested VFX, motion capture, game development, procedural animation, virtual production, and Unreal Engine topics, then edit their keywords and sources."/><WrapPanel><Button Content="Add example topics" Command="{Binding ExampleTopicsCommand}"/><Button Content="Edit topics" Command="{Binding OpenTopicsCommand}"/></WrapPanel><ListBox ItemsSource="{Binding Topics}" DisplayMemberPath="Name" Height="220"/><WrapPanel><Button Content="Back" Command="{Binding SetupBackCommand}"/><Button Content="Next: schedule" Command="{Binding SetupNextCommand}"/></WrapPanel></StackPanel></ScrollViewer></TabItem>
        <TabItem Header="Schedule"><ScrollViewer><StackPanel Margin="22" MaxWidth="790" HorizontalAlignment="Left"><TextBlock Text="Schedule" FontSize="26" FontWeight="Bold"/><TextBlock Margin="0,8,0,16" Text="Daily at 8:00 AM is the default. Use the Schedule tab for weekdays, morning and evening, custom times, topics, wake, and missed-run settings."/><ListBox ItemsSource="{Binding Schedules}" DisplayMemberPath="Name" Height="180"/><WrapPanel><Button Content="Edit schedules" Command="{Binding OpenScheduleCommand}"/><Button Content="Back" Command="{Binding SetupBackCommand}"/><Button Content="Next: ready" Command="{Binding SetupNextCommand}"/></WrapPanel></StackPanel></ScrollViewer></TabItem>
        <TabItem Header="Ready"><ScrollViewer><StackPanel Margin="22" MaxWidth="790" HorizontalAlignment="Left"><TextBlock Text="Ready to monitor" FontSize="26" FontWeight="Bold"/><TextBlock Margin="0,8,0,16" Text="Run diagnostics, then enable the schedule. You can run a scan now and open its report from Home or Reports."/><WrapPanel><Button Content="Run diagnostics" Command="{Binding RunDiagnosticsCommand}"/><Button Content="Enable monitoring" Command="{Binding EnableMonitoringCommand}"/><Button Content="Run now" Command="{Binding RunNowCommand}"/></WrapPanel><TextBlock Text="{Binding LatestRun}" FontSize="17" Margin="0,16,0,8"/><WrapPanel><Button Content="Back" Command="{Binding SetupBackCommand}"/><Button Content="Open reports" Command="{Binding OpenReportsCommand}"/></WrapPanel></StackPanel></ScrollViewer></TabItem>
      </TabControl></TabItem>
      <TabItem Header="Home"><ScrollViewer><StackPanel Margin="22">
        <TextBlock Text="Research status" FontSize="26" FontWeight="Bold"/><TextBlock Text="{Binding LatestRun}" FontSize="18" Margin="0,16,0,20"/><CheckBox Content="Monitoring enabled" IsChecked="{Binding MonitoringEnabled}" IsEnabled="False"/><WrapPanel Margin="0,20,0,0"><Button Content="Run Now" Command="{Binding RunNowCommand}"/><Button Content="Discover links only" Command="{Binding DiscoveryOnlyCommand}"/><Button Content="Stop" Command="{Binding StopCommand}"/><Button Content="Pause Monitoring" Command="{Binding PauseMonitoringCommand}"/><Button Content="Refresh" Command="{Binding RefreshCommand}"/></WrapPanel><Button Content="Report format and length" Command="{Binding OpenReportsCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding ReportProgress}" Foreground="#176B52" Margin="0,8,0,8"/><TextBlock Text="Latest report" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,8"/><Button Content="Open selected report" Command="{Binding OpenReportCommand}" HorizontalAlignment="Left"/><ListBox ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}" Height="220"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Topics"><ScrollViewer><StackPanel Margin="22">
        <TextBlock Text="Topics" FontSize="26" FontWeight="Bold"/><DataGrid ItemsSource="{Binding Topics}" SelectedItem="{Binding SelectedTopic}" AutoGenerateColumns="False" IsReadOnly="True" Height="260" Margin="0,15,0,20"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="100"/><DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="100"/><DataGridTextColumn Header="Max age (hours)" Binding="{Binding MaxAgeHours}" Width="140"/></DataGrid.Columns></DataGrid>
        <TextBlock Text="Name"/><TextBox Text="{Binding TopicName,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="ANY keywords, separated by commas"/><TextBox Text="{Binding TopicTerms,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="ALL required keywords"/><TextBox Text="{Binding TopicAll}"/><TextBlock Text="Exact phrases"/><TextBox Text="{Binding TopicExact}"/><TextBlock Text="Exclude terms"/><TextBox Text="{Binding TopicExclude}"/><TextBlock Text="Synonyms"/><TextBox Text="{Binding TopicSynonyms}"/><TextBlock Text="Allowed domains (optional)"/><TextBox Text="{Binding TopicDomains}"/><TextBlock Text="Sources for selected topic" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding TopicSources}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><WrapPanel><TextBlock Text="Priority" VerticalAlignment="Center"/><TextBox Width="65" Text="{Binding TopicPriority}"/><TextBlock Text="Max age hours" VerticalAlignment="Center"/><TextBox Width="65" Text="{Binding TopicMaxAge}"/><TextBlock Text="Max results" VerticalAlignment="Center"/><TextBox Width="65" Text="{Binding TopicMaxResults}"/><CheckBox Content="Enabled" IsChecked="{Binding TopicEnabled}" VerticalAlignment="Center"/></WrapPanel><WrapPanel><Button Content="Add topic" Command="{Binding AddTopicCommand}"/><Button Content="Save selected topic" Command="{Binding SaveTopicCommand}"/></WrapPanel>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Sources"><ScrollViewer><StackPanel Margin="22">
        <TextBlock Text="Sources and policy" FontSize="26" FontWeight="Bold"/><TextBlock Margin="0,8,0,20" Text="Web search and RSS are automatic. Manual imports require your action. LinkedIn discovery uses indexed search results. The setting below controls whether Signal Atlas asks DokoBot to read LinkedIn pages."/>
        <DataGrid ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" AutoGenerateColumns="False" IsReadOnly="True" Height="260"><DataGrid.Columns><DataGridTextColumn Header="Source" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="130"/><DataGridTextColumn Header="Policy" Binding="{Binding DisplayPolicy}" Width="200"/><DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="90"/></DataGrid.Columns></DataGrid>
        <Button Content="Enable / disable selected source" Command="{Binding ToggleSourceCommand}" HorizontalAlignment="Left" Margin="0,12,0,8"/><TextBlock Text="Add an RSS feed, search source, or permitted website" FontWeight="SemiBold"/><WrapPanel><TextBox Width="160" Text="{Binding SourceName}" ToolTip="Source name"/><TextBox Width="330" Text="{Binding SourceUrl}" ToolTip="Feed or source URL"/><ComboBox Width="100" SelectedValuePath="Content" SelectedValue="{Binding SourceType}"><ComboBoxItem Content="rss"/><ComboBoxItem Content="search"/><ComboBoxItem Content="direct_web"/></ComboBox><Button Content="Add source" Command="{Binding AddSourceCommand}"/></WrapPanel>
        <Border Background="#FFF2DC" Padding="16" Margin="0,16,0,0"><StackPanel><CheckBox Content="Block LinkedIn DokoBot reads" IsChecked="{Binding BlockLinkedInReads,Mode=TwoWay}" FontWeight="Bold"/><TextBlock Margin="0,8,0,0" Text="{Binding LinkedInPolicyStatus}" FontWeight="SemiBold"/><TextBlock Margin="0,8,0,0" Text="On: scheduled scans discover LinkedIn links but do not read pages. Off: Signal Atlas can read multiple discovered LinkedIn pages in scheduled scans and selected batches. This does not change DokoBot itself. LinkedIn's published rules prohibit third-party extraction, including browser extensions."/></StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Schedule"><ScrollViewer><StackPanel Margin="22">
        <TextBlock Text="Schedules" FontSize="26" FontWeight="Bold"/><DataGrid ItemsSource="{Binding Schedules}" SelectedItem="{Binding SelectedSchedule}" AutoGenerateColumns="False" IsReadOnly="True" Height="250" Margin="0,16,0,18"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Time" Binding="{Binding TimeOfDay}" Width="100"/><DataGridTextColumn Header="Days" Binding="{Binding Days.Length}" Width="80"/><DataGridTextColumn Header="Mode" Binding="{Binding ReportMode}" Width="130"/><DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="90"/></DataGrid.Columns></DataGrid>
        <TextBlock Text="Name"/><TextBox Text="{Binding ScheduleName}"/><TextBlock Text="Time (24-hour HH:mm)"/><TextBox Text="{Binding ScheduleTime}"/><TextBlock Text="Days, separated by commas"/><TextBox Text="{Binding ScheduleDays}"/><TextBlock Text="Report mode"/><ComboBox Width="190" HorizontalAlignment="Left" SelectedValuePath="Content" SelectedValue="{Binding ScheduleReportMode}"><ComboBoxItem Content="normal"/><ComboBoxItem Content="discovery_only"/></ComboBox><TextBlock Text="Maximum run time (minutes)"/><TextBox Text="{Binding ScheduleMaxRuntime}"/><WrapPanel><CheckBox Content="Enabled" IsChecked="{Binding ScheduleEnabled}" Margin="0,0,20,0"/><CheckBox Content="Run after missed start" IsChecked="{Binding ScheduleStartMissed}" Margin="0,0,20,0"/><CheckBox Content="Wake computer" IsChecked="{Binding ScheduleWake}"/></WrapPanel><TextBlock Text="Topics for selected schedule" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding ScheduleTopics}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><WrapPanel><Button Content="New schedule" Command="{Binding NewScheduleCommand}"/><Button Content="Add / save schedule" Command="{Binding AddScheduleCommand}"/><Button Content="Delete selected" Command="{Binding DeleteScheduleCommand}"/><Button Content="Enable Monitoring" Command="{Binding EnableMonitoringCommand}"/><Button Content="Pause" Command="{Binding PauseMonitoringCommand}"/></WrapPanel>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="AI Model"><ScrollViewer><StackPanel Margin="22">
        <TextBlock Text="AI analysis provider" FontSize="26" FontWeight="Bold"/>
        <TextBlock Text="Choose local LM Studio, OpenAI API billing, or Codex CLI signed in with your ChatGPT account." Margin="0,8,0,10"/>
        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding AiProvider,Mode=TwoWay}" Width="300" HorizontalAlignment="Left">
          <ComboBoxItem Content="LM Studio (local)" Tag="lm_studio"/>
          <ComboBoxItem Content="OpenAI API key" Tag="openai_api"/>
          <ComboBoxItem Content="Codex with ChatGPT sign-in" Tag="codex_chatgpt"/>
        </ComboBox>
        <TextBlock Text="Local LM Studio model (no API key required)" FontWeight="SemiBold" Margin="0,18,0,3"/>
        <WrapPanel><Button Content="Find installed models" Command="{Binding LoadModelsCommand}"/><Button Content="Install fast model" Command="{Binding InstallFastCommand}"/><Button Content="Install quality model" Command="{Binding InstallQualityCommand}"/></WrapPanel>
        <DataGrid ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" AutoGenerateColumns="False" IsReadOnly="True" Height="220"><DataGrid.Columns><DataGridTextColumn Header="Model" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*"/><DataGridTextColumn Header="Context" Binding="{Binding MaxContext}" Width="90"/><DataGridTextColumn Header="Quantization" Binding="{Binding Quantization}" Width="110"/></DataGrid.Columns></DataGrid>
        <Button Content="Use selected local model" Command="{Binding SelectModelCommand}" HorizontalAlignment="Left"/>
        <TextBlock Text="Selected model:"/><TextBlock Text="{Binding SelectedModelKey}" FontSize="18" FontWeight="SemiBold"/>
        <WrapPanel><Button Content="Save provider settings" Command="{Binding SaveAiSettingsCommand}"/><Button Content="Test selected model / provider" Command="{Binding TestModelCommand}"/></WrapPanel>
        <Expander Header="OpenAI API and Codex settings" Margin="0,18,0,0"><StackPanel>
          <TextBlock Text="Cloud providers send selected source text to OpenAI for analysis. The API key is read from OPENAI_API_KEY; Signal Atlas does not save it. Codex uses its own CLI login and Signal Atlas never reads the login tokens." TextWrapping="Wrap" Margin="0,10,0,12"/>
          <TextBlock Text="OpenAI API model ID" FontWeight="SemiBold" Margin="0,18,0,3"/>
          <TextBox Width="280" HorizontalAlignment="Left" Text="{Binding OpenAiModel,UpdateSourceTrigger=PropertyChanged}"/>
          <Button Content="Check API key availability" Command="{Binding CheckApiCommand}" HorizontalAlignment="Left"/>
          <TextBlock Text="Codex CLI with ChatGPT" FontWeight="SemiBold" Margin="0,18,0,3"/>
          <TextBlock Text="Install Codex CLI separately, then sign in through its browser flow. Your ChatGPT plan must allow Codex usage." TextWrapping="Wrap"/>
          <WrapPanel><Button Content="Sign in with ChatGPT via Codex" Command="{Binding SignInCodexCommand}"/><Button Content="Check Codex sign-in" Command="{Binding CheckCodexCommand}"/></WrapPanel>
        </StackPanel></Expander>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Capture"><ScrollViewer><StackPanel Margin="22">
        <TextBlock Text="Capture chosen content" FontSize="26" FontWeight="Bold"/><TextBlock Margin="0,8,0,15" Text="Choose a topic and paste a URL. To import text yourself, select and copy visible content in your browser, then click Capture copied content. For multiple LinkedIn pages, enter one URL per line and use DokoBot capture when LinkedIn reads are unblocked."/>
        <TextBlock Text="Topic"/><ComboBox ItemsSource="{Binding Topics}" SelectedItem="{Binding SelectedTopic}" DisplayMemberPath="Name" Height="32" Margin="0,4,0,12"/><TextBlock Text="LinkedIn URLs (one per line)"/><TextBox Text="{Binding CaptureUrls,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="105"/><TextBlock Text="Title"/><TextBox Text="{Binding CaptureTitle}"/><TextBlock Text="Optional selected text (otherwise clipboard is used)"/><TextBox Text="{Binding CaptureText,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="110"/><WrapPanel><Button Content="Capture copied content" Command="{Binding CaptureCopiedCommand}"/><Button Content="Capture URLs with DokoBot" Command="{Binding CaptureDokoBatchCommand}"/></WrapPanel>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Reports"><ScrollViewer><StackPanel Margin="22">
        <TextBlock Text="Research output" FontSize="26" FontWeight="Bold"/>
        <TextBlock Text="Keep the card digest for browsing sources. Choose a research report for a developed document with citations, conclusions, and a paginated PDF." Margin="0,8,0,18"/>
        <WrapPanel>
          <StackPanel Margin="0,0,22,12"><TextBlock Text="Create" FontWeight="SemiBold"/><ComboBox Width="220" SelectedValuePath="Tag" SelectedValue="{Binding ReportOutput}"><ComboBoxItem Content="Cards and research report" Tag="both"/><ComboBoxItem Content="Card digest only" Tag="cards"/><ComboBoxItem Content="Research report only" Tag="report"/></ComboBox></StackPanel>
          <StackPanel Margin="0,0,22,12"><TextBlock Text="Report page target (1–20)" FontWeight="SemiBold"/><ComboBox Width="140" ItemsSource="{Binding ReportPageChoices}" SelectedItem="{Binding ReportPages}"/></StackPanel>
          <StackPanel Margin="0,0,0,12"><TextBlock Text="Report profile" FontWeight="SemiBold"/><ComboBox Width="190" SelectedValuePath="Tag" SelectedValue="{Binding ReportProfile}"><ComboBoxItem Content="General research" Tag="research"/><ComboBoxItem Content="Technical analysis" Tag="technical"/><ComboBoxItem Content="Business analysis" Tag="business"/></ComboBox></StackPanel>
        </WrapPanel>
        <TextBlock Text="Research question or objective" FontWeight="SemiBold"/><TextBox Text="{Binding ReportQuestion,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="65" ToolTip="What should the report explain, compare, or help you decide? Leave blank to cover the selected research topics."/>
        <TextBlock Text="Audience" FontWeight="SemiBold"/><TextBox Text="{Binding ReportAudience,UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Specialized elements to include when supported by the evidence" FontWeight="SemiBold"/>
        <ItemsControl ItemsSource="{Binding ReportModules}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" Width="260" Margin="0,8,10,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Text="Reports are written in sections and may take several minutes. The PDF is checked against the selected page limit. Thin evidence can produce a shorter report; figures require sourced numbers. Discovery-only runs produce cards." Foreground="#52665C" Margin="0,12,0,8"/>
        <WrapPanel><Button Content="Save report preferences" Command="{Binding SaveReportOptionsCommand}"/><Button Content="Run research now" Command="{Binding RunNowCommand}"/></WrapPanel>
        <TextBlock Text="{Binding ReportProgress}" Foreground="#176B52" Margin="0,8,0,8"/>
        <Separator Margin="0,20,0,15"/>
        <TextBlock Text="Saved research" FontSize="22" FontWeight="Bold"/>
        <ListBox ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}" Height="150" Margin="0,12,0,10"/>
        <WrapPanel><Button Content="Open cards" Command="{Binding OpenCardsCommand}" IsEnabled="{Binding HasCards}"/><Button Content="Open report" Command="{Binding OpenNarrativeCommand}" IsEnabled="{Binding HasResearchReport}"/><Button Content="Open PDF" Command="{Binding OpenPdfCommand}" IsEnabled="{Binding HasPdf}"/><Button Content="Open original / legacy output" Command="{Binding OpenReportCommand}"/></WrapPanel>
        <WrapPanel><Button Content="Export cards HTML" Command="{Binding ExportCardsCommand}" IsEnabled="{Binding HasCards}"/><Button Content="Export report HTML" Command="{Binding ExportNarrativeCommand}" IsEnabled="{Binding HasResearchReport}"/><Button Content="Export PDF" Command="{Binding ExportPdfCommand}" IsEnabled="{Binding HasPdf}"/><Button Content="Copy summary" Command="{Binding CopySummaryCommand}"/></WrapPanel>
        <WrapPanel><Button Content="Delete selected run's outputs" Command="{Binding DeleteReportCommand}"/><Button Content="Open reports folder" Command="{Binding OpenReportsFolderCommand}"/><Button Content="Refresh" Command="{Binding RefreshCommand}"/></WrapPanel>
        <TextBlock Text="Sources in selected run" FontSize="18" FontWeight="SemiBold" Margin="0,15,0,5"/>
        <DataGrid ItemsSource="{Binding ReportEntries}" SelectedItem="{Binding SelectedReportEntry}" AutoGenerateColumns="False" IsReadOnly="True" Height="220"><DataGrid.Columns><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Topic" Binding="{Binding Topic}" Width="150"/><DataGridCheckBoxColumn Header="Bookmarked" Binding="{Binding Bookmarked}" Width="110"/></DataGrid.Columns></DataGrid>
        <Button Content="Bookmark / unbookmark selected item" Command="{Binding ToggleBookmarkCommand}" HorizontalAlignment="Left"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Diagnostics"><StackPanel Margin="22"><TextBlock Text="Diagnostics" FontSize="26" FontWeight="Bold"/><Button Content="Run full diagnostic" Command="{Binding RunDiagnosticsCommand}" HorizontalAlignment="Left"/><DataGrid ItemsSource="{Binding Diagnostics}" AutoGenerateColumns="False" IsReadOnly="True" Height="460" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="Component" Binding="{Binding Component}" Width="180"/><DataGridCheckBoxColumn Header="Healthy" Binding="{Binding Healthy}" Width="90"/><DataGridTextColumn Header="Detail" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></TabItem>
      <TabItem Header="Settings"><ScrollViewer><StackPanel Margin="22" MaxWidth="650" HorizontalAlignment="Left">
        <TextBlock Text="Settings" FontSize="26" FontWeight="Bold"/><TextBlock Text="AI resource protection is always on. Browser and model requests run one at a time." Margin="0,10,0,20"/>
        <TextBlock Text="Preferred context (tokens)"/><TextBox Text="{Binding PreferredContext}"/><TextBlock Text="Minimum context (tokens)"/><TextBox Text="{Binding MinimumContext}"/><CheckBox Content="Restrict AI on low battery" IsChecked="{Binding RestrictBattery}" Margin="0,8,0,20"/>
        <TextBlock Text="Keep reports (days)"/><TextBox Text="{Binding ReportsRetentionDays}"/><TextBlock Text="Keep normalized content (days)"/><TextBox Text="{Binding ContentRetentionDays}"/><TextBlock Text="Keep search cache (days)"/><TextBox Text="{Binding CacheRetentionDays}"/><TextBlock Text="Keep logs (days)"/><TextBox Text="{Binding LogsRetentionDays}"/><Button Content="Save settings" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left"/>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
  </DockPanel>
</Window>
